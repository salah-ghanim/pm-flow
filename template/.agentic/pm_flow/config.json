{
  "version": 1,
  "domain": "{{DOMAIN}}",
  "roles": {
    "cpo": {
      "cli": "claude",
      "model": "claude-fable-5",
      "difficulty": "xhigh"
    },
    "pm": {
      "cli": "claude",
      "model": "claude-fable-5",
      "difficulty": "xhigh"
    },
    "developer": {
      "cli": "codex",
      "model": "gpt-5.6-sol",
      "difficulty": "xhigh"
    },
    "consultant": [
      {
        "cli": "claude",
        "model": "claude-fable-5",
        "difficulty": "xhigh"
      },
      {
        "cli": "codex",
        "model": "gpt-5.6-sol",
        "difficulty": "xhigh"
      }
    ],
    "10x_developer": {
      "cli": "claude",
      "model": "claude-fable-5",
      "difficulty": "max"
    },
    "maintenance_engineer": {
      "cli": "codex",
      "model": "gpt-5.6-sol",
      "difficulty": "xhigh"
    }
  },
  "access": {
    "write_roles": [
      "developer",
      "10x_developer",
      "maintenance_engineer"
    ],
    "scoped_roles": [
      "pm",
      "cpo"
    ],
    "scoped_write_paths": [],
    "scoped_isolate_settings": true
  },
  "isolation": {
    "worktrees": true
  },
  "budget": {
    "max_usd": 0,
    "max_usd_per_section": 0
  },
  "governance": {
    "portfolio_review_dispatches": 12,
    "portfolio_review_usd": 20,
    "portfolio_review_idle_cycles": 8
  },
  "escalation": {
    "failures_before_consultant": 2,
    "max_rescue_attempts": 1,
    "cycles_before_convergence_review": 6,
    "scope_history_cycles": 2,
    "failure_brief_cycles": 3,
    "max_maintenance_attempts": 2
  },
  "supervision": {
    "heartbeat_stall_seconds": 900,
    "silent_stall_seconds": 3600,
    "max_attempt_seconds": 10800,
    "max_attempts": 4,
    "max_step_claims": 3,
    "retry_backoff_seconds": 30,
    "usage_limit_pause_seconds": 1800
  }
}
