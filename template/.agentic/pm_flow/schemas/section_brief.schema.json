{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "section_brief.schema.json",
  "title": "Parsed section brief",
  "type": "object",
  "required": ["shape", "headings", "acceptance_ids", "priority", "priority_loss"],
  "properties": {
    "shape": {
      "type": "string",
      "enum": ["legacy", "full"]
    },
    "headings": {
      "type": "object"
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": ["must-have", "nice-to-have"]
    },
    "priority_loss": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "x-full-shape-heading": "Deliverables",
  "x-acceptance-heading": "Acceptance",
  "x-priority-heading": "Priority",
  "oneOf": [
    {
      "properties": {
        "shape": {
          "enum": ["legacy"]
        },
        "headings": {
          "required": [
            "Objective",
            "Scope",
            "Priority",
            "Owned paths",
            "Dependencies",
            "Acceptance",
            "Rejection conditions"
          ]
        }
      }
    },
    {
      "properties": {
        "shape": {
          "enum": ["full"]
        },
        "headings": {
          "required": [
            "Objective",
            "Current baseline",
            "Deliverables",
            "User-visible scenarios",
            "Interfaces produced",
            "Interfaces consumed",
            "Scope",
            "Non-goals",
            "Priority",
            "Owned paths",
            "Dependencies",
            "Constraints and fixed decisions",
            "Acceptance",
            "Rejection conditions",
            "Open questions"
          ]
        },
        "acceptance_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^`?A[0-9]+`?\\s*[:.—-]"
          }
        }
      }
    }
  ]
}
