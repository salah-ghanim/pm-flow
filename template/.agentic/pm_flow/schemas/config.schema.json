{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "pm-flow configuration",
  "type": "object",
  "required": [
    "version",
    "domain",
    "roles",
    "access",
    "supervision",
    "telemetry",
    "budget",
    "governance",
    "escalation",
    "isolation"
  ],
  "properties": {
    "version": {"type": "integer"},
    "domain": {"type": "string"},
    "roles": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": ["cli", "model", "difficulty"],
            "properties": {
              "cli": {"type": "string", "enum": ["claude", "codex", "copilot", "acp"]},
              "model": {"type": "string"},
              "difficulty": {"type": "string", "enum": ["low", "medium", "high", "xhigh", "max"]}
            }
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["cli", "model", "difficulty"],
              "properties": {
                "cli": {"type": "string", "enum": ["claude", "codex", "copilot", "acp"]},
                "model": {"type": "string"},
                "difficulty": {"type": "string", "enum": ["low", "medium", "high", "xhigh", "max"]}
              }
            }
          }
        ]
      }
    },
    "access": {
      "type": "object",
      "required": ["write_roles", "scoped_roles", "scoped_write_paths", "scoped_isolate_settings"],
      "properties": {
        "write_roles": {"type": "array", "items": {"type": "string"}},
        "scoped_roles": {"type": "array", "items": {"type": "string"}},
        "scoped_write_paths": {"type": "array", "items": {"type": "string"}},
        "scoped_isolate_settings": {"type": "boolean"}
      }
    },
    "supervision": {
      "type": "object",
      "required": ["heartbeat_stall_seconds", "silent_stall_seconds", "max_attempt_seconds", "max_attempts", "max_step_claims", "retry_backoff_seconds", "usage_limit_pause_seconds"],
      "properties": {
        "heartbeat_stall_seconds": {"type": "integer"},
        "silent_stall_seconds": {"type": "integer"},
        "max_attempt_seconds": {"type": "integer"},
        "max_attempts": {"type": "integer"},
        "max_step_claims": {"type": "integer"},
        "retry_backoff_seconds": {"type": "integer"},
        "usage_limit_pause_seconds": {"type": "integer"}
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["enabled", "otlp_endpoint", "headers"],
      "properties": {
        "enabled": {"type": "integer"},
        "otlp_endpoint": {"type": "string"},
        "headers": {"type": "object"}
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_usd", "max_usd_per_section"],
      "properties": {
        "max_usd": {"type": "number"},
        "max_usd_per_section": {"type": "number"}
      }
    },
    "governance": {
      "type": "object",
      "required": ["portfolio_review_dispatches", "portfolio_review_usd", "portfolio_review_idle_cycles"],
      "properties": {
        "portfolio_review_dispatches": {"type": "integer"},
        "portfolio_review_usd": {"type": "number"},
        "portfolio_review_idle_cycles": {"type": "integer"}
      }
    },
    "escalation": {
      "type": "object",
      "required": ["failures_before_consultant", "max_rescue_attempts", "cycles_before_convergence_review", "scope_history_cycles", "failure_brief_cycles", "max_maintenance_attempts"],
      "properties": {
        "failures_before_consultant": {"type": "integer"},
        "max_rescue_attempts": {"type": "integer"},
        "cycles_before_convergence_review": {"type": "integer"},
        "scope_history_cycles": {"type": "integer"},
        "failure_brief_cycles": {"type": "integer"},
        "max_maintenance_attempts": {"type": "integer"}
      }
    },
    "isolation": {
      "type": "object",
      "required": ["worktrees"],
      "properties": {
        "worktrees": {"type": "boolean"}
      }
    }
  }
}
