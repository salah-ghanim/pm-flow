# Copy this file to `local_env.sh` and customize it per project.
#
# It is sourced by `.claude/pm_flow/net_exec.sh` before your command runs.
# Keep it small and deterministic.
#
# Examples:
#
# export PATH="$PROJECT_ROOT/node_modules/.bin:$PATH"
# export PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
# export SOME_PROJECT_FLAG=1
