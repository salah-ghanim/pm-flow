.DS_Store
.idea/
template/.agentic/pm_flow/project/runs/*
!template/.agentic/pm_flow/project/runs/.gitkeep

# Python bytecode from the flow's own modules.
__pycache__/
*.pyc

# The self-hosting instance. pm-flow is installed into its own repository as the
# `pm-agent` project so it can work on itself. Almost none of it belongs in git:
# what install.sh writes there is scaffolding it can write again, and what the
# flow writes there while running is a record, not a definition. Reproduce it
# with:
#
#   ./install.sh . --name "pm-flow self-hosting" --project-key pm_agent
#
# What is kept is the part that was authored rather than generated: the plan, the
# section briefs, and the dependency graph between them.
.agentic/*
!.agentic/pm_flow/
.agentic/pm_flow/*
!.agentic/pm_flow/pm-agent/
.agentic/pm_flow/pm-agent/*
!.agentic/pm_flow/pm-agent/project_state/
!.agentic/pm_flow/pm-agent/sections/
.agentic/pm_flow/pm-agent/sections/*/cycles/
.agentic/pm_flow/pm-agent/sections/*/runs/

# The rendered agent-instructions files are generated from template/AGENTS.md
# and template/CLAUDE.md at install time. The templates are the source; a
# rendered copy only drifts from them.
/AGENTS.md
/CLAUDE.md

# The store is local by construction. Committing it recreates exactly the churn
# it exists to remove.
**/pm_flow.db
**/pm_flow.db-wal
**/pm_flow.db-shm

# Runtime locks, not state.
.agentic/pm_flow/*/sections/.*.lock
.agentic/pm_flow/*/sections/*.lock
.agentic/pm_flow/*/sections/*/.driver.lock

# Per-dispatch scratch. Rewritten on every dispatch, meaningless afterwards, and
# exactly the churn the plan says the host repository must not absorb.
.agentic/pm_flow/*/sections/*/.last_error.txt
.agentic/pm_flow/*/sections/*/.pre_dispatch.txt
.agentic/pm_flow/*/sections/*/.post_dispatch.txt
.agentic/pm_flow/*/sections/*/.verdict_error.txt

# Build artifacts from packaging.
dist/
build/
*.egg-info/
.venv/
